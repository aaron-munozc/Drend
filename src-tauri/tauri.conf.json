{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drend",
  "version": "0.1.0",
  "identifier": "com.drend.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Drend",
        "width": 1000,
        "height": 700,
        "minHeight": 800,
        "minWidth": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Video Downloader & Extractor CLI",
      "args": [
        {
          "name": "server",
          "short": "s",
          "description": "Start the application alongside the Axum server",
          "takesValue": false
        },
        {
          "name": "background",
          "short": "b",
          "description": "Run in headless mode",
          "takesValue": false
        }
      ]
    }
  }
}
